{
  "name": "@companion-module/liveupdate",
  "version": "1.1.0",
  "description": "Companion module for disguise LiveUpdate API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "companion",
    "HELP.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json",
    "test": "yarn build && tsx --test test/*.test.ts",
    "test:only": "tsx --test test/*.test.ts",
    "live:verify": "node scripts/live-verify.mjs",
    "lint:raw": "eslint",
    "lint": "eslint .",
    "format": "prettier -w src scripts eslint.config.mjs",
    "presets:generate": "node scripts/gen-presets.mjs && prettier -w src/presetCatalog.ts",
    "help:generate": "node scripts/gen-help.mjs",
    "catalog:render": "node scripts/render-catalog.mjs",
    "package": "npm pack"
  },
  "prettier": "@companion-module/tools/.prettierrc.json",
  "keywords": [
    "bitfocus",
    "companion",
    "module",
    "disguise",
    "designer",
    "liveupdate"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@companion-module/base": "~1.13.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@companion-module/tools": "^2.8.0",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.5.10",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.5",
    "tslib": "^2.6.2",
    "tsx": "^4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
